# Where the JetKVM is and the token from `setCuaApiConfig` (see README)
KVM_URL=http://192.168.1.50
KVM_TOKEN=

# Keyboard layout of the REMOTE machine (any isoCode from the JetKVM UI, e.g. en-US, de-DE)
KVM_KEYBOARD_LAYOUT=en-US

# TypeSafe Jev decision model
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# UI parser: omniparser | ocr | null
CUA_PARSER=omniparser
# torch device for OmniParser: auto | mps | cuda | cpu
CUA_DEVICE=auto
# OCR: auto (Apple Vision on macOS, EasyOCR elsewhere) | vision | easyocr
CUA_OCR=auto
# Florence-2 captions for icons without text. Off: about 0.4 s per screen, such icons are
# "unlabeled icon". On: about 0.2 s per new icon (8–20 s on a new screen, cached afterwards)
CUA_CAPTION_ICONS=false

# MCP server (what the LeanScope agent server connects to)
CUA_MCP_HOST=127.0.0.1
CUA_MCP_PORT=8765
CUA_MCP_TOKEN=

# When stuck, ask the human (dashboard or remote control) and wait this long for an answer
CUA_HUMAN_WAIT_S=45

# Rough screen description for people following a run (any OpenAI-compatible API; none = off)
CUA_VISION_PROVIDER=openai
CUA_VISION_MODEL=gpt-4.1-mini
CUA_VISION_BASE_URL=https://api.openai.com/v1

LEANSCOPE_OPENAI_API_KEY=

# Inner voice: the acting persona of the picked choreo thinks the activity log aloud, in German,
# in the dashboard (switch "🔊 Inner voice" in the activity log). Needs the OpenAI key above for the
# thoughts, ElevenLabs for the voice, and a LeanScope login with a picked choreo for the persona.
ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# CUA_INNER_VOICE=true                 # on at start
# CUA_INNER_VOICE_MODEL=gpt-4.1-mini
# CUA_INNER_VOICE_PERSONA_GUID=        # empty: the choreo's primary actor
# CUA_INNER_VOICE_ID=                  # ElevenLabs voice id when the persona has none attached

# Live narration into a LeanScope agent-server session (off while this is empty).
# The API host, not the web UI host (dev: https://dev.api.agents.leanscope.ai).
# Log in to LeanScope and pick the choreo in the dashboard's "LeanScope" panel: the choreo fills in
# the goal (personaGoal) and hints (preconditions), and each run starts a session of it.
# The login (refresh token, never the password) and the choice are kept in CUA_STATE_FILE
# (default .leanscope-session.json, git-ignored).
LEANSCOPE_AGENT_SERVER_URL=
# Optional overrides, prod by default:
# LEANSCOPE_API_URL=https://api.leanscope.io
# LEANSCOPE_SUPABASE_URL=https://ezmofhpfycarkvhcfvje.supabase.co
# LEANSCOPE_SUPABASE_ANON_KEY=
# The remote control app; the dashboard's QR code links here with ?agentServer=…&sessionToken=…
LEANSCOPE_REMOTE_CONTROL_URL=
# How the agent server reaches this service; the choreo's Worker dispatcher is
# CUA_PUBLIC_URL/worker/dispatch?key=CUA_WORKER_KEY (the dashboard shows the full URL)
CUA_PUBLIC_URL=
CUA_WORKER_KEY=
